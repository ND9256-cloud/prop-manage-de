// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
}

// User Roles
enum UserRole {
  PLATFORM_ADMIN // Global superuser
  ORG_ADMIN      // Admin for a specific organization
  PROPERTY_MANAGER
  ACCOUNTANT
  TENANT
  VENDOR
}

// Property Types
enum PropertyType {
  APARTMENT_BUILDING // Mehrfamilienhaus
  SINGLE_FAMILY_HOME // Einfamilienhaus
  MIXED_USE          // Wohn- und Geschäftshaus
  COMMERCIAL         // Gewerbe
}

// Lease Status
enum LeaseStatus {
  ACTIVE
  PENDING
  ENDED
  CANCELLED
}



// Organization (Tenant) - The Property Management Company
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique // For diverse subdomains if needed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users           User[]
  properties      Property[]
  tenants         Person[]
  bankConnections BankConnection[]
  bankAccounts    BankAccount[]
}

// User - System users (Admins, Managers, Accountants)
// Tenants have their own profile linked here purely for auth if they log in
model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String?
  hashedPassword String?  // If using credential auth; optional if using Clerk/Auth.js with social
  role           UserRole @default(PROPERTY_MANAGER)
  
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  

}

// Property - A physical building or complex
model Property {
  id        String   @id @default(uuid())
  name      String   // E.g. "Sunset Apartments" or "Musterstraße 123"
  address   String
  city      String
  zip       String
  country   String   @default("DE")
  yearBuilt Int?
  type      PropertyType

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  units            Unit[]
  documents        Document[]
  serviceProviders ServiceProvider[]
  bankTransactions BankTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Unit - A rentable space within a property
model Unit {
  id           String  @id @default(uuid())
  unitNumber   String  // E.g. "Top 12", "Apt 4B"
  floor        Int?
  sizeSqm      Float   // Square meters (German standard)
  rooms        Float?  // E.g. 2.5 rooms
  
  // Base rent configuration
  targetColdRent Float? // Kaltmiete prediction
  
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id])

  leases       Lease[]
  currentTenant Lease? @relation("CurrentLease")
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Person - A repository of people (Tenants, Vendors contacts, etc.)
// Separated from User because they might not have login access initially
model Person {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  leases           Lease[]
  bankTransactions BankTransaction[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Lease (Tenancy) - The contract
model Lease {
  id        String      @id @default(uuid())
  startDate DateTime
  endDate   DateTime?   // Null means indefinite (unbefristet)
  status    LeaseStatus @default(ACTIVE)
  
  // Financials (German breakdown)
  coldRent      Float // Kaltmiete
  utilityAdvance Float // Nebenkosten-Vorauszahlung
  parkingRent   Float?
  deposit       Float // Kaution

  // Bank Info for SEPA
  iban          String?
  bic           String?

  // Rent increase tracking
  rentIncreaseRule    String?    // "§ 558 BGB" or "VPI-Index"
  lastRentIncreaseAt  DateTime?  // Kaltmiete zuletzt erhöht am
  cpiAtIncrease       Float?     // VPI Stand bei Erhöhung
  cpiCurrent          Float?     // VPI Stand heute

  unitId    String
  unit      Unit   @relation(fields: [unitId], references: [id])
  
  // For simplicity, one main tenant per lease for now, or use relation table for many-to-many
  mainTenantId String
  mainTenant   Person @relation(fields: [mainTenantId], references: [id])

  // Optimization: Relation back to Unit for "current lease" if active?
  // Prisma doesn't support conditional relations easily, handled in logic.
  currentUnit Unit? @relation("CurrentLease", fields: [currentUnitId], references: [id])
  currentUnitId String? @unique 



  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



// VPI (Verbraucherpreisindex) – Consumer Price Index from Destatis
model VpiIndex {
  id    String @id @default(uuid())
  year  Int
  month Int    // 1-12
  value Float  // VPI value (basis 2020 = 100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
  @@index([year, month])
}

// Document - Files stored in Supabase Storage, linked to a property
model Document {
  id          String   @id @default(uuid())
  name        String   // Original filename or user-given name
  type        String   // "contract", "invoice", "notice", "other"
  storagePath String   // Path in Supabase storage bucket
  fileSize    Int      // Bytes
  mimeType    String   // "application/pdf", "image/jpeg", etc.

  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ServiceProvider - Utilities, insurance, taxes linked to a property
model ServiceProvider {
  id             String   @id @default(uuid())
  name           String   // e.g. "Stadtwerke München"
  category       String   // strom, gas, wasser, heizung, versicherung, grundbesitzabgaben, hausverwaltung, sonstige
  contractNumber String?  // Vertragsnummer
  monthlyCost    Float?   // EUR/month
  yearlyCost     Float?   // EUR/year
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  notes          String?

  propertyId     String
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Bank Connection - A link to a bank via Enable Banking
model BankConnection {
  id              String   @id @default(uuid())
  aspspName       String   // e.g. "Deutsche Kreditbank (DKB)"
  aspspCountry    String   @default("DE")
  sessionId       String?  @unique // Enable Banking session ID
  authorizationId String?  // Enable Banking authorization ID
  status          String   @default("PENDING") // PENDING, ACTIVE, EXPIRED, ERROR

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  accounts        BankAccount[]

  validUntil      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Bank Account - An individual bank account within a connection
model BankAccount {
  id               String   @id @default(uuid())
  externalId       String   @unique // Enable Banking account ID
  iban             String?
  ownerName        String?

  bankConnectionId String
  bankConnection   BankConnection @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])

  transactions     BankTransaction[]
  lastSyncedAt     DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Bank Transaction - Individual booking entries (Buchungsjournal)
model BankTransaction {
  id                   String   @id @default(uuid())
  entryReference       String?  // Bank's transaction ID (for dedup)
  bookingDate          DateTime
  valueDate            DateTime?
  amount               Float    // Positive = credit, negative = debit
  currency             String   @default("EUR")
  creditDebitIndicator String?  // "CRDT" or "DBIT"
  debtorName           String?
  debtorIban           String?
  creditorName         String?
  creditorIban         String?
  purpose              String?  // remittance_information
  transactionCode      String?

  bankAccountId        String
  bankAccount          BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  // Manual assignment (auto-propagated by IBAN)
  propertyId           String?
  property             Property? @relation(fields: [propertyId], references: [id])
  tenantId             String?
  tenant               Person?   @relation(fields: [tenantId], references: [id])
  category             String?   // e.g. "Bruttomieteinnahmen", "Kaution", etc.

  createdAt            DateTime @default(now())

  @@unique([bankAccountId, entryReference])
  @@index([bankAccountId, bookingDate])
  @@index([tenantId])
  @@index([propertyId])
}
